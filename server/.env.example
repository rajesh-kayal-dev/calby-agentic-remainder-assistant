# ==========================================
# Calby - Server Configuration Template
# ==========================================

# ------------------------------------------
# Server & Application
# ------------------------------------------
PORT=4000
APP_URL=http://localhost:3000
SERVER_URL=http://localhost:4000

# ------------------------------------------
# PostgreSQL Database (Neon or Self-Hosted)
# ------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/calby?sslmode=disable

# ------------------------------------------
# Descope Authentication & User Management
# ------------------------------------------
DESCOPE_PROJECT_ID=your_descope_project_id
DESCOPE_MANAGEMENT_KEY=your_descope_management_key
DESCOPE_CALENDAR_CONNECTION_ID=google-calendar

# ------------------------------------------
# AI Provider Defaults & Security
# ------------------------------------------
OPENAI_API_KEY=your_openai_api_key
AI_MODEL=gpt-4o-mini
LLM_ENCRYPTION_SECRET=your_32_byte_aes_encryption_secret_key!

# ------------------------------------------
# Redis & Background Notification Queue (BullMQ)
# ------------------------------------------
# Leave empty for in-memory / direct notification dispatch fallback
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# SMTP Email Transport (Nodemailer)
# ------------------------------------------
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=noreply@calby.app
EMAIL_FROM_NAME="Calby Assistant"
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# ------------------------------------------
# Telegram Notifications & Webhook
# ------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=CalbyBot
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret

# ------------------------------------------
# WhatsApp Business Cloud API
# ------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v18.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_verify_token

# ------------------------------------------
# Google OAuth & APIs (Calendar, Gmail, Docs, Sheets)
# ------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/connections/google/callback

# ------------------------------------------
# Schedulers & Workers
# ------------------------------------------
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_INTERVAL_MS=5000
REMINDER_SCHEDULER_BATCH_SIZE=25

# ------------------------------------------
# Model Context Protocol (MCP) Server
# ------------------------------------------
DESCOPE_MCP_SERVER_WELL_KNOWN_URL=
