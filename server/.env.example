# ==========================================
# Calby — Server Configuration Template
# ==========================================

# ------------------------------------------
# Server & Application
# ------------------------------------------
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000
SERVER_URL=http://localhost:4000

# ------------------------------------------
# PostgreSQL Database (Neon or Self-Hosted)
# ------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/calby?sslmode=disable

# ------------------------------------------
# Descope Authentication & User Management
# ------------------------------------------
DESCOPE_PROJECT_ID=your_descope_project_id
DESCOPE_MANAGEMENT_KEY=your_descope_management_key

# ------------------------------------------
# Nango Integration Layer (OAuth for Google,
# Notion, Slack, Microsoft Teams, etc.)
# ------------------------------------------
NANGO_SECRET_KEY=<YOUR_NANGO_SECRET_KEY>

# ------------------------------------------
# AI Provider Defaults & Security
# ------------------------------------------
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
AI_MODEL=gpt-4o-mini
LLM_ENCRYPTION_SECRET=<YOUR_32_BYTE_AES_ENCRYPTION_SECRET>

# ------------------------------------------
# Redis & Background Notification Queue (BullMQ)
# ------------------------------------------
# Leave empty for in-memory / direct notification dispatch fallback
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# SMTP Email Transport (Nodemailer)
# ------------------------------------------
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=noreply@calby.app
EMAIL_FROM_NAME="Calby Assistant"
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=<YOUR_SMTP_USERNAME>
SMTP_PASS=<YOUR_SMTP_PASSWORD>
SMTP_SECURE=false

# ------------------------------------------
# Telegram Notifications & Webhook
# ------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
TELEGRAM_BOT_USERNAME=CalbyAssistantBot
TELEGRAM_WEBHOOK_SECRET=<YOUR_TELEGRAM_WEBHOOK_SECRET>

# ------------------------------------------
# WhatsApp Business Cloud API
# ------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v18.0
WHATSAPP_ACCESS_TOKEN=<YOUR_WHATSAPP_ACCESS_TOKEN>
WHATSAPP_PHONE_NUMBER_ID=<YOUR_WHATSAPP_PHONE_NUMBER_ID>
WHATSAPP_BUSINESS_ACCOUNT_ID=<YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID>
WHATSAPP_VERIFY_TOKEN=<YOUR_WHATSAPP_WEBHOOK_VERIFY_TOKEN>

# ------------------------------------------
# Schedulers & Workers
# ------------------------------------------
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_INTERVAL_MS=5000
REMINDER_SCHEDULER_BATCH_SIZE=25

# ------------------------------------------
# Model Context Protocol (MCP) Server
# ------------------------------------------
DESCOPE_MCP_SERVER_WELL_KNOWN_URL=
